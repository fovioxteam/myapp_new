<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CADisableMinimumFrameDurationOnPhone</key>
        <true/>
        <key>CFBundleDevelopmentRegion</key>
        <string>$(DEVELOPMENT_LANGUAGE)</string>
        <key>CFBundleDisplayName</key>
        <string>Foviox</string>
        <key>CFBundleExecutable</key>
        <string>$(EXECUTABLE_NAME)</string>
        <key>CFBundleIdentifier</key>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
        <key>CFBundleInfoDictionaryVersion</key>
        <string>6.0</string>
        <key>CFBundleName</key>
        <string>foviox</string>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleShortVersionString</key>
        <string>$(FLUTTER_BUILD_NAME)</string>
        <key>CFBundleSignature</key>
        <string>????</string>
        <key>CFBundleVersion</key>
        <string>$(FLUTTER_BUILD_NUMBER)</string>
        <key>LSRequiresIPhoneOS</key>
        <true/>

        <!-- URL SCHEMES (GOOGLE SIGN-IN И DEEP LINKS) -->
        <key>CFBundleURLTypes</key>
        <array>
            <!-- Google Auth -->
            <dict>
                <key>CFBundleTypeRole</key>
                <string>Editor</string>
                <key>CFBundleURLSchemes</key>
                <array>
                    <string>com.googleusercontent.apps.370877420307-7sbprm77lg96b4svsmr792k5a3pqhrs4</string>
                </array>
            </dict>
            <!-- Deep Links -->
            <dict>
                <key>CFBundleTypeRole</key>
                <string>Editor</string>
                <key>CFBundleURLName</key>
                <string>com.foviox.app</string>
                <key>CFBundleURLSchemes</key>
                <array>
                    <string>foviox</string>
                </array>
            </dict>
        </array>

        <!-- РАЗРЕШЕННЫЕ ВНЕШНИЕ СХЕМЫ -->
        <key>LSApplicationQueriesSchemes</key>
        <array>
            <string>https</string>
            <string>http</string>
        </array>

        <!-- РАЗРЕШЕНИЯ ПОЛЬЗОВАТЕЛЯ -->
        <key>NSPhotoLibraryUsageDescription</key>
        <string>Для загрузки и публикации фото и видео</string>
        <key>NSCameraUsageDescription</key>
        <string>Для съемки фото и видео в приложении</string>
        <key>NSMicrophoneUsageDescription</key>
        <string>Для записи звука при создании видео</string>
        <key>NSPhotoLibraryAddUsageDescription</key>
        <string>Для сохранения фото и видео в галерею</string>

        <!-- ФОНОВЫЕ РЕЖИМЫ (PUSH, FETCH И АУДИО) -->
        <key>UIBackgroundModes</key>
        <array>
            <string>remote-notification</string>
            <string>fetch</string>
            <string>audio</string>
        </array>

        <!-- APP TRANSPORT SECURITY -->
        <key>NSAppTransportSecurity</key>
        <dict>
            <key>NSAllowsArbitraryLoads</key>
            <true/>
        </dict>

        <!-- DEEP LINKING -->
        <key>FlutterDeepLinkingEnabled</key>
        <true/>

        <!-- ОФОРМЛЕНИЕ И СТАТУС-БАР -->
        <key>UIViewControllerBasedStatusBarAppearance</key>
        <false/>
        <key>UIStatusBarHidden</key>
        <false/>
        <!-- 🔥 БЕЛЫЕ ИКОНКИ ДЛЯ ТЕМНОГО ФОНА -->
        <key>UIStatusBarStyle</key>
        <string>UIStatusBarStyleLightContent</string>
        <key>UIViewEdgeAntialiasing</key>
        <true/>
        <key>UILaunchStoryboardName</key>
        <string>LaunchScreen</string>
        <key>UIMainStoryboardFile</key>
        <string>Main</string>

        <!-- ОРИЕНТАЦИЯ ЭКРАНА -->
        <key>UISupportedInterfaceOrientations</key>
        <array>
            <string>UIInterfaceOrientationPortrait</string>
        </array>
        <key>UISupportedInterfaceOrientations~ipad</key>
        <array>
            <string>UIInterfaceOrientationPortrait</string>
            <string>UIInterfaceOrientationPortraitUpsideDown</string>
            <string>UIInterfaceOrientationLandscapeLeft</string>
            <string>UIInterfaceOrientationLandscapeRight</string>
        </array>

        <!-- FIREBASE -->
        <key>FirebaseScreenReportingEnabled</key>
        <true/>

        <!-- ПОДДЕРЖКА МНОГООКОННОСТИ И БЭДЖЕЙ -->
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
</plist>