<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Foviox</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>foviox</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>

		<!-- ✅ РАЗРЕШЕНИЯ (УЖЕ ЕСТЬ) -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Для загрузки и публикации фото и видео</string>
		<key>NSCameraUsageDescription</key>
		<string>Для съемки фото и видео в приложении</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Для записи звука при создании видео</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Для сохранения фото и видео в галерею</string>

		<!-- ✅ НОВОЕ: ДОСТУП К КОНТАКТАМ (ЕСЛИ НУЖНО) -->
		<!--
		<key>NSContactsUsageDescription</key>
		<string>Для поиска друзей по контактам</string>
		-->

		<!-- ✅ НОВОЕ: PUSH-УВЕДОМЛЕНИЯ -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
			<string>audio</string>
		</array>

		<!-- ✅ НОВОЕ: APP TRANSPORT SECURITY (ДЛЯ HTTP) -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
		</dict>

		<!-- ✅ DEEP LINKING -->
		<key>FlutterDeepLinkingEnabled</key>
		<true/>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.yourcompany.foviox</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>foviox</string>
				</array>
			</dict>
		</array>

		<!-- ✅ НОВОЕ: APP LINKS (ДЛЯ WEB-ССЫЛОК) -->
		<key>FlutterDeepLinkingEnabled</key>
		<true/>

		<!-- ✅ ПОЛНОЭКРАННЫЙ РЕЖИМ -->
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UIStatusBarStyle</key>
		<string>UIStatusBarStyleLightContent</string>

		<!-- ✅ EDGE-TO-EDGE -->
		<key>UIViewEdgeAntialiasing</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>

		<!-- ✅ ОРИЕНТАЦИЯ -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>

		<!-- ✅ НОВОЕ: FIREBASE (ЕСЛИ ИСПОЛЬЗУЕТЕ) -->
		<key>FirebaseScreenReportingEnabled</key>
		<true/>

		<!-- ✅ НОВОЕ: РАЗРЕШЕНИЕ НА ОТСЛЕЖИВАНИЕ (ДЛЯ РЕКЛАМЫ) -->
		<!--
		<key>NSUserTrackingUsageDescription</key>
		<string>Для показа персонализированной рекламы</string>
		-->

		<!-- ✅ НОВОЕ: ФОНОВОЕ ВОСПРОИЗВЕДЕНИЕ ВИДЕО -->
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>remote-notification</string>
		</array>
	</dict>
</plist>